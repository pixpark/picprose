# Unsplash 访问密钥（服务端用，不要加 NEXT_PUBLIC_ 前缀）
# https://unsplash.com/documentation
UNSPLASH_API_KEY=

# Google Analytics 测量 ID（可选）
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Umami 统计的站点 ID（可选）
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# 出网代理（可选）
# api.unsplash.com 直连不通时（国内常见），服务端取图需要走代理。
# Node 的 fetch 不认 macOS/Windows 的「系统代理」设置，只认这两个环境变量；
# 路由里看到它们就会自动打开 NODE_USE_ENV_PROXY，不用自己设。
# 端口按自己的代理软件填（Clash Verge 默认 7890）。
# HTTPS_PROXY=http://127.0.0.1:7890
